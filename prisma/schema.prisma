generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Sex {
  male
  female
}

enum GoalType {
  loss
  gain
  maintain
}

enum ActivityLevel {
  sedentary
  light
  moderate
  active
  very_active
}

enum MealType {
  breakfast
  morning_snack
  lunch
  afternoon_snack
  dinner
}

enum ActivityType {
  sport
  steps
}

enum FoodSource {
  ciqual
  ai
  manual
  openfoodfacts
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  sex          Sex?
  birthDate    DateTime?
  heightCm     Float?
  leanMassKg   Float?
  createdAt    DateTime  @default(now())

  goal            Goal?
  weightEntries   WeightEntry[]
  activityEntries ActivityEntry[]
  meals           Meal[]
  dishes          Dish[]
  measurements    BodyMeasurement[]
  manualIntakes   ManualDayIntake[]
  weeklyReviews   WeeklyReview[]
}

model Goal {
  id             String        @id @default(cuid())
  userId         String        @unique
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  type           GoalType
  targetKg       Float?
  weeklyRateKg   Float?
  activityLevel  ActivityLevel @default(sedentary)
  startDate      DateTime      @default(now())
  targetKcal     Int?
  manualKcal     Int?
  targetProteinG Int?
  targetCarbG    Int?
  targetFatG     Int?
  targetFiberG   Int?
  updatedAt      DateTime      @updatedAt
}

model WeightEntry {
  id       String   @id @default(cuid())
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date     DateTime
  weightKg Float

  @@unique([userId, date])
  @@index([userId, date])
}

model BodyMeasurement {
  id      String   @id @default(cuid())
  userId  String
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date    DateTime
  chestCm Float?
  waistCm Float?
  thighCm Float?

  @@unique([userId, date])
  @@index([userId, date])
}

// Total de kcal mangées saisi à la main pour un jour sans repas (bilan hebdo).
model ManualDayIntake {
  id     String   @id @default(cuid())
  userId String
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date   DateTime
  kcal   Float

  @@unique([userId, date])
}

model WeeklyReview {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  weekStart DateTime
  createdAt DateTime @default(now())

  @@unique([userId, weekStart])
}

model ActivityEntry {
  id            String       @id @default(cuid())
  userId        String
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  date          DateTime
  type          ActivityType
  name          String?
  value         Float
  estimatedKcal Int

  @@index([userId, date])
}

model Meal {
  id     String     @id @default(cuid())
  userId String
  user   User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  date   DateTime
  type   MealType
  items  FoodItem[]

  @@unique([userId, date, type])
  @@index([userId, date])
}

model FoodItem {
  id          String         @id @default(cuid())
  mealId      String
  meal        Meal           @relation(fields: [mealId], references: [id], onDelete: Cascade)
  referenceId String?
  reference   FoodReference? @relation(fields: [referenceId], references: [id])
  dishId      String?
  dish        Dish?          @relation(fields: [dishId], references: [id], onDelete: SetNull)
  portions    Float?
  name        String
  quantityG   Float
  kcal        Float
  proteinG    Float
  carbG       Float
  fatG        Float
  fiberG      Float
}

model FoodReference {
  id              String           @id @default(cuid())
  ciqualId        String           @unique
  name            String
  kcal            Float
  proteinG        Float
  carbG           Float
  fatG            Float
  fiberG          Float
  source          FoodSource       @default(ciqual)
  items           FoodItem[]
  dishIngredients DishIngredient[]

  @@index([name])
}

model Dish {
  id          String           @id @default(cuid())
  userId      String
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  kcal        Float
  proteinG    Float
  carbG       Float
  fatG        Float
  servings    Int?
  createdAt   DateTime         @default(now())
  items       FoodItem[]
  ingredients DishIngredient[]

  @@index([userId])
}

model DishIngredient {
  id          String        @id @default(cuid())
  dishId      String
  dish        Dish          @relation(fields: [dishId], references: [id], onDelete: Cascade)
  referenceId String
  reference   FoodReference @relation(fields: [referenceId], references: [id])
  quantityG   Float
  pieces      Float?

  @@index([dishId])
}
